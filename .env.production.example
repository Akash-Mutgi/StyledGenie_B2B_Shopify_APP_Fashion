OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TIMEOUT_SECONDS=30
OPENAI_REASONING_EFFORT=low
OPENAI_TEXT_VERBOSITY=low

SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Create or map a merchant row for the new production store.
DEFAULT_MERCHANT_ID=your_new_production_merchant_uuid_here

GOOGLE_VISION_API_KEY=your_google_vision_key_here
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}
GOOGLE_CLOUD_PROJECT=your-project-id

# Shopify production app + store configuration.
SHOPIFY_APP_NAME=StyledGenieB2B_Production
SHOPIFY_APP_URL=https://app.your-production-domain.com
SHOPIFY_STORE_DOMAIN=your-production-store.myshopify.com
SHOPIFY_STOREFRONT_DOMAIN=www.your-production-store.com
SHOPIFY_API_VERSION=2026-01
SHOPIFY_CLIENT_ID=your_production_shopify_client_id_here
SHOPIFY_CLIENT_SECRET=your_production_shopify_client_secret_here
SHOPIFY_ADMIN_ACCESS_TOKEN=your_production_shopify_admin_access_token_here
SHOPIFY_ORDERS_LOOKBACK_DAYS=60
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_production_storefront_token_here

# Public backend base used by Shopify Admin and the theme app embed.
APP_BASE_URL=https://app.your-production-domain.com

SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=support@your-production-domain.com
SMTP_REPLY_TO=support@your-production-domain.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
