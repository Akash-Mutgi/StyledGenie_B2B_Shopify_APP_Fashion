OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-5-mini
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DEFAULT_MERCHANT_ID=11111111-1111-1111-1111-111111111111
GOOGLE_VISION_API_KEY=your_google_vision_key_here
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}
GOOGLE_CLOUD_PROJECT=your-project-id
SHOPIFY_APP_NAME=StyledGenieB2B_Test
SHOPIFY_APP_URL=https://shopify.dev/apps/default-app-home
# Dev store from admin.shopify.com/store/ea4aad-0f → use the myshopify.com domain:
SHOPIFY_STORE_DOMAIN=ea4aad-0f.myshopify.com
SHOPIFY_STOREFRONT_DOMAIN=ea4aad-0f.myshopify.com
SHOPIFY_API_VERSION=2026-01
SHOPIFY_CLIENT_ID=your_shopify_client_id_here
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret_here
SHOPIFY_ADMIN_ACCESS_TOKEN=your_shopify_admin_access_token_here
# Shopify app scopes needed for catalog + stock sync: read_products, read_inventory
# Add read_orders if you want customer care order tracking from live Shopify data.
SHOPIFY_ORDERS_LOOKBACK_DAYS=60
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_token_here
APP_BASE_URL=http://localhost:8000
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=support@styledgenie.com
SMTP_REPLY_TO=support@styledgenie.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
