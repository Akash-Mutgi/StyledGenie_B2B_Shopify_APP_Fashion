{% assign api_base_url = block.settings.api_base_url | default: 'http://127.0.0.1:8000' %}

<link rel="stylesheet" href="{{ 'chat-widget.css' | asset_url }}?v=20260414b">
<script src="{{ 'preferences-onboarding.js' | asset_url }}?v=20260414b" defer></script>
<script src="{{ 'chat-entry-flow.js' | asset_url }}?v=20260414b" defer></script>
<script src="{{ 'chat-widget.js' | asset_url }}?v=20260414b" defer></script>

<div
  id="styledgenie-chat-root"
  class="styledgenie-chat-root"
  data-api-base="{{ api_base_url }}"
  data-cart-root="{{ routes.root_url }}"
  data-store-domain="{{ shop.permanent_domain }}"
  data-my-style-url="{{ routes.account_url }}"
  data-account-login-url="{{ routes.account_login_url | default: '/account/login' }}"
  data-customer-id="{% if customer %}{{ customer.id }}{% else %}shopify-storefront-guest{% endif %}"
  data-customer-name="{% if customer %}{{ customer.first_name | append: ' ' | append: customer.last_name | strip | escape }}{% else %}Guest Shopper{% endif %}"
  data-customer-email="{% if customer %}{{ customer.email | escape }}{% endif %}"
  data-customer-avatar=""
></div>

{% schema %}
{
  "name": "StyledGenie Chat",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "api_base_url",
      "label": "Backend API Base URL",
      "default": "http://127.0.0.1:8000"
    }
  ]
}
{% endschema %}
